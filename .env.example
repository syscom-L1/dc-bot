NODE_ENV=development
TIMEZONE=Asia/Taipei
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

DATABASE_URL=postgresql://dcbot:dcbot@localhost:5440/dcbot?schema=public
REDIS_URL=redis://localhost:6380

DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated allowlists.
DISCORD_GUILD_IDS=
DISCORD_CHANNEL_IDS=
DISCORD_ADMIN_ROLE_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_SUMMARY_CHANNEL_ID=
DISCORD_LEAVE_CHANNEL_ID=
DISCORD_ALERT_CHANNEL_ID=

GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
# Use base64 in production, or a PEM string with escaped newlines locally.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_ORGANIZATION=
GITHUB_PROJECT_ID=
GITHUB_INSTALLATION_ID=

# OpenAI-compatible endpoint. Required by the Bot process.
CUBI_LLM_BASE_URL=
CUBI_LLM_API_KEY=
CUBI_LLM_MODEL=
CUBI_LLM_FALLBACK_MODEL=
CUBI_LLM_TIMEOUT_MS=30000

# Optional Google service account; prefer the base64 form in production.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_REMINDER_MINUTES=15

# Optional signed POST /webhooks/monitoring integration.
MONITORING_ENABLED=false
MONITORING_WEBHOOK_SECRET=

DAILY_REPORT_REMINDER_CRON=30 16 * * 1-5
DAILY_SUMMARY_CRON=0 17 * * 1-5
MORNING_NOTIFICATION_CRON=0 8 * * 1-5
WEEKLY_SUMMARY_CRON=0 16 * * 5
REMINDER_CRON=0 10 * * 1-5
GITHUB_RECONCILIATION_CRON=15 */6 * * *
DUE_SOON_DAYS=3
INACTIVITY_HOURS=48
REVIEW_WAIT_HOURS=24
AUTO_UPDATE_GITHUB_STATUS=false
